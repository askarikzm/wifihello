# Global
ENVIRONMENT=development
DOMAIN=wancom.local
LOG_LEVEL=info
PORT=9000

# Supabase Auth & DB
SUPABASE_URL=https://project-id.supabase.co
SUPABASE_ANON_KEY=public-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key
SUPABASE_JWKS_URL=https://project-id.supabase.co/auth/v1/keys
SUPABASE_JWT_AUD=authenticated
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_API_BASE=http://localhost:9000

# Network Service (internal microservice)
NETWORK_SERVICE_URL=http://network-service:9100
NETWORK_SERVICE_API_KEY=replace_with_generated_key

# Payment Gateways
PAYFAST_MERCHANT_ID=
PAYFAST_PASSPHRASE=
PAYMENT_WEBHOOK_SECRET=replace_webhook_secret

# Observability
PROMETHEUS_PUSH_ENDPOINT=http://prometheus:9091
LOKI_ENDPOINT=http://loki:3100
